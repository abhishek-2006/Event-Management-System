@model IEnumerable<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Campus Events";
    var now = DateTime.Today;

    var liveEvents = Model.Where(e => e.EventDate.Date == now).OrderBy(e => e.EventDate).ToList();
    var upcomingEvents = Model.Where(e => e.EventDate.Date > now).OrderBy(e => e.EventDate).ToList();
    var pastEvents = Model.Where(e => e.EventDate.Date < now).OrderByDescending(e => e.EventDate).ToList();

    int totalCount = Model.Count();
    int techCount = Model.Count(e => e.Category == "Technical");
    int cultCount = Model.Count(e => e.Category == "Cultural");
    int sportCount = Model.Count(e => e.Category == "Sports");
    int eduCount = Model.Count(e => e.Category == "Education");
}

<div class="py-10 max-w-7xl mx-auto px-6 space-y-16">
    <!-- Search & Category Filter Header -->
    <section class="space-y-8">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
            <div class="animate-in fade-in slide-in-from-left-8 duration-700">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-purple/10 border border-brand-purple/20 text-brand-purple text-[10px] font-black uppercase tracking-widest mb-3">
                    <span>⚡</span> Comprehensive Catalog
                </div>
                <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tight uppercase italic leading-none">
                    Campus <span class="text-transparent bg-clip-text bg-brand-gradient">Events</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 font-medium text-base md:text-lg mt-3 max-w-xl">
                    Explore hackathons, sports meets, cultural nights, and academic workshops.
                </p>
            </div>
            
            <!-- Category Filter Pills -->
            <div class="flex flex-wrap gap-2 animate-in fade-in slide-in-from-right-8 duration-700" id="filter-buttons">
                <button onclick="filterEvents('all', this)" class="filter-btn active px-4 py-2 rounded-full bg-brand-gradient text-white text-[11px] font-black uppercase tracking-widest shadow-md shadow-brand-purple/25 transition-all flex items-center gap-1.5">
                    <span>All</span>
                    <span class="opacity-80 text-[10px]">(@totalCount)</span>
                </button>
                <button onclick="filterEvents('Technical', this)" class="filter-btn px-4 py-2 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-[11px] font-black uppercase tracking-widest hover:border-brand-purple hover:text-brand-purple transition-all flex items-center gap-1.5">
                    <span>Technical</span>
                    <span class="text-slate-400 text-[10px]">(@techCount)</span>
                </button>
                <button onclick="filterEvents('Cultural', this)" class="filter-btn px-4 py-2 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-[11px] font-black uppercase tracking-widest hover:border-brand-purple hover:text-brand-purple transition-all flex items-center gap-1.5">
                    <span>Cultural</span>
                    <span class="text-slate-400 text-[10px]">(@cultCount)</span>
                </button>
                <button onclick="filterEvents('Sports', this)" class="filter-btn px-4 py-2 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-[11px] font-black uppercase tracking-widest hover:border-brand-purple hover:text-brand-purple transition-all flex items-center gap-1.5">
                    <span>Sports</span>
                    <span class="text-slate-400 text-[10px]">(@sportCount)</span>
                </button>
                <button onclick="filterEvents('Education', this)" class="filter-btn px-4 py-2 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-[11px] font-black uppercase tracking-widest hover:border-brand-purple hover:text-brand-purple transition-all flex items-center gap-1.5">
                    <span>Education</span>
                    <span class="text-slate-400 text-[10px]">(@eduCount)</span>
                </button>
            </div>
        </div>

        <!-- Search Bar with Clear Button -->
        <div class="relative max-w-xl group">
            <input type="text" id="event-search" onkeyup="searchEvents()" placeholder="Search events by title or keywords..." 
                   class="w-full pl-14 pr-12 py-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-full text-base text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-4 focus:ring-brand-purple/10 focus:border-brand-purple outline-none transition-all shadow-sm" />
            <div class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-brand-purple transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <button id="clear-search" onclick="clearSearch()" class="hidden absolute right-4 top-1/2 -translate-y-1/2 w-7 h-7 bg-slate-100 dark:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-white rounded-full flex items-center justify-center text-xs transition-colors" aria-label="Clear search">
                ✕
            </button>
        </div>
    </section>

    <!-- Global No Matching Results State -->
    <div id="no-matching-events" class="hidden py-20 px-8 text-center bg-white dark:bg-slate-900 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-[3.5rem] flex-col items-center justify-center">
        <div class="w-16 h-16 bg-slate-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center text-3xl mb-4">🔍</div>
        <h3 class="text-2xl font-black text-slate-900 dark:text-white uppercase italic tracking-tight mb-2">No Matching Events Found</h3>
        <p class="text-slate-400 font-medium text-sm max-w-md mx-auto mb-6">We couldn't find any events that match your current search criteria or category filter.</p>
        <button onclick="resetAllFilters()" class="px-6 py-3 bg-brand-purple text-white font-black text-xs uppercase tracking-widest rounded-2xl hover:opacity-90 transition-opacity">
            Reset Filters
        </button>
    </div>

    <!-- 1. LIVE NOW (Current Events) -->
    @if (liveEvents.Any())
    {
        <section class="space-y-6 event-section" id="section-live">
            <div class="flex items-center gap-3">
                <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                <span class="w-1.5 h-6 bg-emerald-500 rounded-full"></span>
                <h2 class="text-2xl font-black text-slate-900 dark:text-white uppercase italic tracking-tight">Happening Today</h2>
                <span class="ml-2 text-[10px] font-black uppercase tracking-widest px-3 py-1 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 rounded-full border border-emerald-200 dark:border-emerald-800">Live</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var item in liveEvents)
                {
                    @await Html.PartialAsync("_EventCard", item)
                }
            </div>
        </section>
    }

    <!-- 2. UPCOMING EVENTS -->
    <section class="space-y-6 event-section" id="section-upcoming">
        <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 bg-brand-gradient rounded-full"></span>
            <h2 class="text-2xl font-black text-slate-900 dark:text-white uppercase italic tracking-tight">Upcoming Events</h2>
            <span class="text-xs font-bold text-slate-400">(@upcomingEvents.Count)</span>
        </div>

        @if (!upcomingEvents.Any())
        {
            <div class="p-12 text-center rounded-[2rem] bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-sm">
                <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">No upcoming events scheduled right now.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var item in upcomingEvents)
                {
                    @await Html.PartialAsync("_EventCard", item)
                }
            </div>
        }
    </section>

    <!-- 3. PAST EVENTS (Archived) -->
    @if (pastEvents.Any())
    {
        <section class="space-y-6 pt-10 border-t border-slate-200 dark:border-slate-800/80 event-section" id="section-past">
            <div class="flex items-center gap-3">
                <span class="w-1.5 h-6 bg-slate-300 dark:bg-slate-700 rounded-full"></span>
                <h2 class="text-2xl font-black text-slate-400 dark:text-slate-500 uppercase italic tracking-tight">Past Events</h2>
                <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-full">Archived</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 opacity-80 hover:opacity-100 transition-opacity">
                @foreach (var item in pastEvents)
                {
                    @await Html.PartialAsync("_EventCard", item)
                }
            </div>
        </section>
    }
</div>

<script>
    let currentCategory = 'all';

    function applyVisibility() {
        const query = (document.getElementById('event-search').value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('.event-card');
        const sections = document.querySelectorAll('.event-section');
        const noMatchBox = document.getElementById('no-matching-events');
        const clearBtn = document.getElementById('clear-search');

        if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
        }

        let totalVisible = 0;

        cards.forEach(card => {
            const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
            const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
            
            const matchCat = (currentCategory.toLowerCase() === 'all' || cardCat === currentCategory.toLowerCase());
            const matchSearch = (!query || cardTitle.includes(query));

            if (matchCat && matchSearch) {
                card.style.display = 'flex';
                totalVisible++;
            } else {
                card.style.display = 'none';
            }
        });

        // Hide section headers if section has 0 visible cards
        sections.forEach(sec => {
            const visibleInSec = sec.querySelectorAll('.event-card:not([style*="display: none"])').length;
            const hasStaticEmpty = sec.querySelector('.p-12');
            if (visibleInSec === 0 && !hasStaticEmpty && (query || currentCategory !== 'all')) {
                sec.classList.add('hidden');
            } else {
                sec.classList.remove('hidden');
            }
        });

        // Toggle no-results card
        if (noMatchBox) {
            if (totalVisible === 0) {
                noMatchBox.classList.remove('hidden');
                noMatchBox.classList.add('flex');
            } else {
                noMatchBox.classList.add('hidden');
                noMatchBox.classList.remove('flex');
            }
        }
    }

    function filterEvents(category, btn) {
        currentCategory = category;
        const buttons = document.querySelectorAll('.filter-btn');

        buttons.forEach(b => {
            b.classList.remove('bg-brand-gradient', 'text-white', 'shadow-md', 'shadow-brand-purple/25');
            b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border', 'border-slate-200', 'dark:border-slate-800');
        });

        btn.classList.add('bg-brand-gradient', 'text-white', 'shadow-md', 'shadow-brand-purple/25');
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200');

        applyVisibility();
    }

    function searchEvents() {
        applyVisibility();
    }

    function clearSearch() {
        const input = document.getElementById('event-search');
        if (input) {
            input.value = '';
            applyVisibility();
            input.focus();
        }
    }

    function resetAllFilters() {
        const input = document.getElementById('event-search');
        if (input) input.value = '';
        const allBtn = document.querySelector('.filter-btn');
        if (allBtn) filterEvents('all', allBtn);
    }
</script>