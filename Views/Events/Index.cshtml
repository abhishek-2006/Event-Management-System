@model IEnumerable<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Campus Events";
    var now = DateTime.Today;

    var liveEvents = Model.Where(e => e.EventDate.Date == now).OrderBy(e => e.EventDate).ToList();
    var upcomingEvents = Model.Where(e => e.EventDate.Date > now).OrderBy(e => e.EventDate).ToList();
    var pastEvents = Model.Where(e => e.EventDate.Date < now).OrderByDescending(e => e.EventDate).ToList();
}

<div class="py-12 space-y-20">
    <!-- Search & Category Filter Header -->
    <section class="relative">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
            <div class="animate-in fade-in slide-in-from-left-8 duration-700">
                <h2 class="text-4xl md:text-7xl font-black text-slate-900 dark:text-white tracking-tighter mb-4 uppercase italic">
                    Campus <span class="text-transparent bg-clip-text bg-brand-gradient">Events</span>
                </h2>
                <p class="text-slate-500 dark:text-slate-400 font-medium text-xl">
                    Discover active, upcoming, and past experiences across college.
                </p>
            </div>
            
            <div class="flex flex-wrap gap-3 animate-in fade-in slide-in-from-right-8 duration-700" id="filter-buttons">
                <button onclick="filterEvents('all', this)" class="filter-btn active px-6 py-3 rounded-full bg-brand-gradient text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-brand-purple/20 transition-all">All</button>
                <button onclick="filterEvents('Technical', this)" class="filter-btn px-6 py-3 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-xs font-black uppercase tracking-widest hover:border-brand-purple transition-all">Technical</button>
                <button onclick="filterEvents('Cultural', this)" class="filter-btn px-6 py-3 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-xs font-black uppercase tracking-widest hover:border-brand-purple transition-all">Cultural</button>
                <button onclick="filterEvents('Sports', this)" class="filter-btn px-6 py-3 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-xs font-black uppercase tracking-widest hover:border-brand-purple transition-all">Sports</button>
                <button onclick="filterEvents('Education', this)" class="filter-btn px-6 py-3 rounded-full bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-400 text-xs font-black uppercase tracking-widest hover:border-brand-purple transition-all">Education</button>
            </div>
        </div>

        <div class="relative max-w-3xl group">
            <input type="text" id="event-search" onkeyup="searchEvents()" placeholder="Search active or archived events..." 
                   class="w-full pl-16 pr-8 py-6 bg-white/50 dark:bg-slate-900/50 backdrop-blur-xl border-2 border-slate-100 dark:border-slate-800 rounded-[2.5rem] text-xl text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-8 focus:ring-brand-purple/5 focus:border-brand-purple outline-none transition-all shadow-2xl shadow-slate-200/50 dark:shadow-none" />
            <div class="absolute left-6 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-brand-purple transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
        </div>
    </section>

    <!-- 1. LIVE NOW (Current Events) -->
    @if (liveEvents.Any())
    {
        <section class="space-y-8 event-section">
            <div class="flex items-center gap-3">
                <span class="flex h-3 w-3 rounded-full bg-emerald-500 animate-ping"></span>
                <span class="w-2 h-7 bg-emerald-500 rounded-full"></span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white uppercase italic tracking-tight">Happening Today</h3>
                <span class="ml-2 text-xs font-black uppercase tracking-widest px-3 py-1 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-full border border-emerald-200 dark:border-emerald-800">Registration Open</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                @foreach (var item in liveEvents)
                {
                    @await Html.PartialAsync("_EventCard", item)
                }
            </div>
        </section>
    }

    <!-- 2. UPCOMING EVENTS -->
    <section class="space-y-8 event-section">
        <div class="flex items-center gap-3">
            <span class="w-2 h-7 bg-brand-gradient rounded-full"></span>
            <h3 class="text-3xl font-black text-slate-900 dark:text-white uppercase italic tracking-tight">Upcoming Experiences</h3>
            <span class="text-xs font-bold text-slate-400">(@upcomingEvents.Count)</span>
        </div>

        @if (!upcomingEvents.Any())
        {
            <div class="p-12 text-center rounded-[2.5rem] bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">No upcoming events scheduled right now.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                @foreach (var item in upcomingEvents)
                {
                    @await Html.PartialAsync("_EventCard", item)
                }
            </div>
        }
    </section>

    <!-- 3. PAST EVENTS (Archived) -->
    @if (pastEvents.Any())
    {
        <section class="space-y-8 pt-10 border-t border-slate-100 dark:border-slate-800/80 event-section">
            <div class="flex items-center gap-3">
                <span class="w-2 h-7 bg-slate-300 dark:bg-slate-700 rounded-full"></span>
                <h3 class="text-3xl font-black text-slate-400 dark:text-slate-500 uppercase italic tracking-tight">Past Events</h3>
                <span class="text-xs font-black uppercase tracking-widest px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-full">Archived</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 opacity-75 hover:opacity-100 transition-opacity">
                @foreach (var item in pastEvents)
                {
                    @await Html.PartialAsync("_EventCard", item)
                }
            </div>
        </section>
    }
</div>

<script>
    function filterEvents(category, btn) {
        const cards = document.querySelectorAll('.event-card');
        const buttons = document.querySelectorAll('.filter-btn');

        buttons.forEach(b => {
            b.classList.remove('bg-brand-gradient', 'text-white', 'shadow-lg', 'shadow-brand-purple/20');
            b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');
        });

        btn.classList.add('bg-brand-gradient', 'text-white', 'shadow-lg', 'shadow-brand-purple/20');
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400');

        cards.forEach(card => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function searchEvents() {
        const input = document.getElementById('event-search').value.toLowerCase();
        const cards = document.querySelectorAll('.event-card');

        cards.forEach(card => {
            const title = card.getAttribute('data-title');
            if (title.includes(input)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>