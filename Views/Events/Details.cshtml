@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = @Model.Title;
    var today = DateTime.Now.Date;
    bool notYetOpen = today < Model.RegistrationStartDate.Date;
    bool isClosed = today > Model.RegistrationEndDate.Date;
    bool isOpen = !notYetOpen && !isClosed;
}

<!-- Inside the Right Sidebar Card -->
<div class="space-y-8">
    <div class="space-y-3">
        <h4 class="text-lg font-black text-slate-900 dark:text-white tracking-tight italic uppercase">
            @if (notYetOpen)
            {
                <span>Registration Not Yet Open</span>
            }
            else if (isClosed)
            {
                <span>Registration Closed</span>
            }
            else
            {
                <span>Reserve Your Spot</span>
            }
        </h4>

        <!-- Date Timeline Pills -->
        <div class="flex flex-wrap gap-2 mt-1">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-purple/10 text-brand-purple text-[10px] font-black uppercase tracking-widest border border-brand-purple/20">
                📅 Event: @Model.EventDate.ToString("MMM dd, yyyy")
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-black uppercase tracking-widest border border-emerald-500/20">
                🟢 Opens: @Model.RegistrationStartDate.ToString("MMM dd, yyyy")
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 text-[10px] font-black uppercase tracking-widest border border-rose-500/20">
                🔴 Closes: @Model.RegistrationEndDate.ToString("MMM dd, yyyy")
            </span>
        </div>

        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 leading-relaxed mt-2">
            @if (notYetOpen)
            {
                <span class="text-amber-500 dark:text-amber-400 font-bold">
                    Registration has not opened yet. Check back from <strong class="text-slate-900 dark:text-white">@Model.RegistrationStartDate.ToString("MMM dd, yyyy")</strong>.
                </span>
            }
            else if (isClosed)
            {
                <span class="text-rose-500 dark:text-rose-400 font-bold">
                    Registration closed on <strong>@Model.RegistrationEndDate.ToString("MMM dd, yyyy")</strong>. Delegate list has been finalized.
                </span>
            }
            else
            {
                <span>
                    Registration closes at 11:59 PM on 
                    <strong class="text-slate-900 dark:text-white">@Model.RegistrationEndDate.ToString("MMM dd, yyyy")</strong>.
                    @if (Model.DaysUntilDeadline == 0)
                    {
                        <span class="text-rose-500 font-bold"> — Last day!</span>
                    }
                    else
                    {
                        <span class="text-brand-purple font-bold"> (@Model.DaysUntilDeadline days left)</span>
                    }
                </span>
            }
        </p>
    </div>
    
    @if (isOpen)
    {
        <!-- Active Registration Button -->
        <a asp-action="Register" asp-route-slug="@Model.Slug" 
           class="group relative flex items-center justify-center w-full py-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-xs uppercase tracking-[0.3em] rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[1.02] active:scale-95 shadow-xl shadow-brand-purple/20">
            <span class="relative z-10 flex items-center gap-2 group-hover:text-white transition-colors duration-500">
                Register Now
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </span>
            <div class="absolute inset-0 bg-brand-gradient translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"></div>
        </a>
    }
    else if (notYetOpen)
    {
        <!-- Not Yet Open State -->
        <div class="flex items-center justify-center gap-3 w-full py-5 bg-amber-50 dark:bg-amber-900/10 text-amber-600 dark:text-amber-400 font-black text-xs uppercase tracking-[0.25em] rounded-2xl border border-amber-200 dark:border-amber-800/50 cursor-not-allowed select-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Coming Soon
        </div>
    }
    else
    {
        <!-- Disabled State Badge/Button -->
        <div class="flex items-center justify-center gap-3 w-full py-5 bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 font-black text-xs uppercase tracking-[0.25em] rounded-2xl border border-slate-200 dark:border-slate-700 cursor-not-allowed select-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
            Capacity Locked / Closed
        </div>
    }

    <div class="flex items-center justify-center gap-4 pt-4">
        <div class="h-[1px] flex-grow bg-slate-100 dark:bg-slate-800"></div>
        <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">
            @if (isClosed) { <span>Final Roster Generated</span> }
            else if (notYetOpen) { <span>Pre-Registration Phase</span> }
            else { <span>Advance Booking Required</span> }
        </p>
        <div class="h-[1px] flex-grow bg-slate-100 dark:bg-slate-800"></div>
    </div>
</div>