@model EventManagementSystem.Models.Registration

@{
    ViewData["Title"] = "Event Registration";
}

<div class="max-w-3xl mx-auto py-10 px-6">
    <a asp-action="Details" asp-route-slug="@ViewData["EventSlug"]" 
       class="group inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-brand-purple transition-colors mb-8">
        <span class="group-hover:-translate-x-1 transition-transform">&larr;</span> Back to Details
    </a>

    <div class="relative bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden">
        
        <div class="mb-12 pb-10 border-b border-slate-100 dark:border-slate-800/60">
            <h2 class="text-4xl font-black text-slate-900 dark:text-white tracking-tighter mb-2 italic uppercase">Secure Your Spot</h2>
            <p class="text-lg font-medium text-slate-500 dark:text-slate-400">
                Registering for: <span class="text-transparent bg-clip-text bg-brand-gradient font-black italic">@ViewData["EventTitle"]</span>
            </p>
        </div>

        <form action="/Events/Register" method="post" class="space-y-10">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="EventId" />

            <div class="space-y-3">
                <label asp-for="StudentName" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Full Name</label>
                <input asp-for="StudentName" placeholder="Abhishek Shah" 
                       class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                <span asp-validation-for="StudentName" class="text-red-500 text-[9px] font-black uppercase tracking-widest mt-2 ml-4"></span>
            </div>

            <div class="space-y-3">
                <label asp-for="PhoneNumber" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Phone Number</label>
                <input asp-for="PhoneNumber" placeholder="+91 9876543210" 
                       class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                <span asp-validation-for="PhoneNumber" class="text-red-500 text-[9px] font-black uppercase tracking-widest mt-2 ml-4"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <div class="space-y-3">
                    <label asp-for="EnrollNumber" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Enrollment Number</label>
                    <input asp-for="EnrollNumber" placeholder="e.g. 101" 
                           class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    <span asp-validation-for="EnrollNumber" class="text-red-500 text-[9px] font-black uppercase tracking-widest mt-2 ml-4"></span>
                </div>
                <div class="space-y-3">
                    <label asp-for="Email" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">College Email</label>
                    <input asp-for="Email" placeholder="student@college.edu" 
                           class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    <span asp-validation-for="Email" class="text-red-500 text-[9px] font-black uppercase tracking-widest mt-2 ml-4"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <div class="space-y-3">
                    <label asp-for="Semester" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Semester</label>
                    <input asp-for="Semester" placeholder="e.g. 6" 
                           class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    <span asp-validation-for="Semester" class="text-red-500 text-[9px] font-black uppercase tracking-widest mt-2 ml-4"></span>
                </div>
                <div class="space-y-3">
                    <label asp-for="Department" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Department</label>
                    <input asp-for="Department" placeholder="Computer Science" 
                           class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    <span asp-validation-for="Department" class="text-red-500 text-[9px] font-black uppercase tracking-widest mt-2 ml-4"></span>
                </div>
            </div>

            <div class="pt-6 flex flex-col items-center">
                <button type="submit" 
                        class="group inline-flex items-center justify-center gap-3 px-10 py-4 bg-brand-gradient text-white font-black text-xs uppercase tracking-widest rounded-full transition-all duration-300 shadow-xl shadow-brand-purple/20 hover:shadow-brand-purple/40 hover:scale-105 active:scale-95">
                    <span>Confirm Registration</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </button>
                <p class="text-center text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-4">
                    Registered students will receive a digital pass upon confirmation.
                </p>
            </div>
        </form>
    </div>
</div>