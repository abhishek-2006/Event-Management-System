@model EventManagementSystem.ViewModels.RegistrationViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Elite Event Pass";
}

<div class="py-16 min-h-screen bg-slate-50 dark:bg-slate-950 flex flex-col items-center justify-center px-6 transition-colors selection:bg-brand-purple/30">
    
    <div class="text-center mb-16 animate-in fade-in slide-in-from-bottom-4 duration-1000">
        <div class="flex items-center justify-center gap-4 mb-4">
            <div class="h-[1px] w-12 bg-slate-200 dark:bg-slate-800"></div>
            <span class="text-[10px] font-black text-brand-purple uppercase tracking-[0.5em]">Identity Verified</span>
            <div class="h-[1px] w-12 bg-slate-200 dark:bg-slate-800"></div>
        </div>
        <h1 class="text-6xl md:text-8xl font-black text-slate-900 dark:text-white tracking-tighter uppercase italic leading-none">
            Entry<span class="text-transparent bg-clip-text bg-brand-gradient">.01</span>
        </h1>
    </div>

    <div id="printablePass" class="relative w-full max-w-5xl group perspective-1000">
        
        <div class="absolute -inset-2 bg-brand-gradient rounded-[3rem] blur-2xl opacity-0 group-hover:opacity-20 transition duration-1000"></div>
        
        <div class="relative flex flex-col bg-white dark:bg-slate-900 rounded-[2.5rem] overflow-hidden border-4 border-slate-900 dark:border-white shadow-[0_40px_80px_-15px_rgba(0,0,0,0.3)]">
            
            <div class="bg-slate-900 dark:bg-white px-10 py-4 flex justify-between items-center border-b-4 border-slate-900 dark:border-white">
                <div class="flex items-center gap-4">
                    <div class="w-3 h-3 rounded-full bg-brand-purple animate-ping"></div>
                    <span class="text-white dark:text-slate-900 font-black text-[10px] uppercase tracking-[0.4em]">Official Event Hub Delegate</span>
                </div>
                <span class="text-white/40 dark:text-slate-900/40 font-mono text-[10px]">AUTH_ID: @Model.RegistrationId</span>
            </div>

            <div class="flex flex-col lg:flex-row">
                <div class="flex-[3] p-10 md:p-14 relative overflow-hidden">
                    <div class="absolute -right-20 -bottom-20 text-[15rem] font-black text-slate-50 dark:text-slate-800/10 select-none pointer-events-none italic tracking-tighter uppercase">
                        EH
                    </div>

                    <div class="relative z-10 space-y-12">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-[10px] font-black text-brand-purple uppercase tracking-[0.3em] mb-3">Priority Access For</p>
                                <h2 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tighter uppercase italic leading-tight">
                                    @Model.EventTitle
                                </h2>
                            </div>
                            <div class="w-20 h-20 rounded-2xl border-2 border-slate-100 dark:border-slate-800 p-1 bg-white dark:bg-slate-900 rotate-12 group-hover:rotate-0 transition-transform duration-700 shadow-xl">
                                <img src="~/logo.png" class="w-full h-full object-cover rounded-xl" alt="EH" />
                            </div>
                        </div>

                        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pt-8 border-t-2 border-slate-100 dark:border-slate-800">
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Delegate</label>
                                <p class="text-sm font-black text-slate-900 dark:text-white uppercase truncate">@Model.Name</p>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Enrollment</label>
                                <p class="text-sm font-black text-slate-900 dark:text-white">#@Model.RollNumber</p>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Department</label>
                                <p class="text-sm font-black text-slate-900 dark:text-white uppercase">@Model.Department</p>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Semester</label>
                                <p class="text-sm font-black text-slate-900 dark:text-white uppercase">@Model.Semester</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-1 bg-slate-900 dark:bg-slate-50 p-10 flex flex-col items-center justify-center text-center relative border-t-4 lg:border-t-0 lg:border-l-4 border-dashed border-white/20 dark:border-slate-900/10">
                    
                    <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-slate-50 dark:bg-slate-950 rounded-full border-4 border-slate-900 dark:border-white hidden lg:block"></div>
                    <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-slate-50 dark:bg-slate-950 rounded-full border-4 border-slate-900 dark:border-white hidden lg:block"></div>

                    <div class="w-full space-y-6">
                        <div class="p-4 bg-white dark:bg-slate-900 rounded-3xl shadow-inner border border-white/10">
                             <div class="flex gap-1 h-20 items-end justify-center">
                                @for(int i=0; i<24; i++) {
                                    <div class="w-1 bg-slate-900 dark:bg-brand-purple rounded-full @(i % 4 == 0 ? "h-16" : i % 2 == 0 ? "h-10" : "h-14")"></div>
                                }
                            </div>
                        </div>
                        
                        <div class="space-y-1">
                            <p class="text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.4em]">Entry Key</p>
                            <p class="text-xl font-black text-white dark:text-slate-900 tracking-tighter italic">EH-@Model.RegistrationId-@Model.RollNumber</p>
                        </div>

                        <div class="pt-4 border-t border-white/10 dark:border-slate-900/10">
                             <p class="text-[8px] font-bold text-slate-400 uppercase leading-relaxed tracking-widest">
                                Valid for individual <br/> entry only. <br/> Campus 2026.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-16 flex flex-wrap gap-6 justify-center no-print">
        <button onclick="window.print()" class="group relative px-12 py-5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-xs uppercase tracking-[0.4em] rounded-2xl overflow-hidden hover:scale-105 active:scale-95 transition-all shadow-2xl">
            <span class="relative z-10 flex items-center gap-2">Download Pass <span class="group-hover:translate-y-1 transition-transform">↓</span></span>
            <div class="absolute inset-0 bg-brand-gradient translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
        </button>
        <a href="/Events" class="px-12 py-5 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-black text-xs uppercase tracking-[0.4em] rounded-2xl border-4 border-slate-900 dark:border-white hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-slate-900 transition-all">
            Exit
        </a>
    </div>
</div>