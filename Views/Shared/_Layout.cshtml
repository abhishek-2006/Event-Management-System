@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("Admin"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventHub</title>
    
    <link rel="icon" type="image/jpeg" href="~/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,700;1,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif']
                    },
                    colors: {
                        'brand-purple': '#8b5cf6',
                        'brand-blue': '#3b82f6',
                        'brand-silver': '#e2e8f0'
                    },
                    backgroundImage: {
                        'brand-gradient': 'linear-gradient(to right, #8b5cf6, #3b82f6)',
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans bg-white text-slate-900 dark:bg-slate-950 dark:text-white transition-colors duration-300 flex flex-col min-h-screen selection:bg-brand-purple/30">
    
    <header class="sticky top-0 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 shadow-sm">
        <nav class="container mx-auto px-6 py-4">
            <div class="flex justify-between items-center">
                <a href="@(isAdmin ? "/Admin/Dashboard" : "/")" class="flex items-center gap-3 group">
                    <div class="relative w-12 h-12 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 shadow-lg shadow-brand-purple/10">
                        <img src="~/logo.png" alt="EH Logo" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                    </div>
                    <div class="flex flex-col">
                        <span class="font-black text-xl tracking-tighter text-slate-900 dark:text-white uppercase leading-none">
                            Event<span class="text-transparent bg-clip-text bg-brand-gradient">Hub</span>
                        </span>
                        <span class="text-[8px] font-bold text-slate-400 tracking-[0.3em] mt-1 uppercase">Curating Moments</span>
                    </div>
                </a>

                <div class="hidden md:flex items-center gap-8">
                    <div class="flex gap-2 text-[11px] font-black uppercase tracking-widest">
                        @if (isAdmin)
                        {
                            <a href="/Admin/Dashboard" class="px-5 py-2.5 rounded-xl transition-all @(currentAction == "Dashboard" ? "bg-brand-purple text-white shadow-lg shadow-brand-purple/20" : "text-slate-500 hover:text-brand-purple hover:bg-slate-50 dark:hover:bg-slate-900")">Dashboard</a>
                            <a href="/Admin/ManageEvents" class="px-5 py-2.5 rounded-xl transition-all @(currentAction == "ManageEvents" ? "bg-brand-purple text-white shadow-lg shadow-brand-purple/20" : "text-slate-500 hover:text-brand-purple hover:bg-slate-50 dark:hover:bg-slate-900")">Manage Events</a>
                            <a href="/Admin/ViewRegistrations" class="px-5 py-2.5 rounded-xl transition-all @(currentAction == "ViewRegistrations" ? "bg-brand-purple text-white shadow-lg shadow-brand-purple/20" : "text-slate-500 hover:text-brand-purple hover:bg-slate-50 dark:hover:bg-slate-900")">View Registrations</a>
                            <a href="/Admin/Logout" class="px-5 py-2.5 rounded-xl text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all border border-transparent hover:border-red-200">Logout</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index" class="px-5 py-2.5 rounded-xl transition-all @(currentController == "Home" && currentAction == "Index" ? "bg-brand-purple text-white shadow-lg shadow-brand-purple/20" : "text-slate-500 hover:text-brand-purple hover:bg-slate-50 dark:hover:bg-slate-900")">Home</a>
                            <a asp-controller="Events" asp-action="Index" class="px-5 py-2.5 rounded-xl transition-all @(currentController == "Events" ? "bg-brand-purple text-white shadow-lg shadow-brand-purple/20" : "text-slate-500 hover:text-brand-purple hover:bg-slate-50 dark:hover:bg-slate-900")">Events</a>
                            <a asp-controller="Home" asp-action="Contact" class="px-5 py-2.5 rounded-xl transition-all @(currentController == "Home" && currentAction == "Contact" ? "bg-brand-purple text-white shadow-lg shadow-brand-purple/20" : "text-slate-500 hover:text-brand-purple hover:bg-slate-50 dark:hover:bg-slate-900")">Contact</a>
                        }
                    </div>
                    
                    <button id="theme-toggle" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-500 border border-slate-200 dark:border-slate-800 hover:border-brand-purple transition-all">
                        <span class="dark:hidden text-lg">🌙</span>
                        <span class="hidden dark:inline text-lg text-brand-purple">☀️</span>
                    </button>
                </div>

                <button id="mobile-menu-button" class="md:hidden p-2 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors" aria-label="Toggle Navigation Menu">
                    <svg id="mobile-menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </div>

            <!-- Mobile Navigation Drawer -->
            <div id="mobile-menu" class="hidden md:hidden pt-4 pb-2 border-t border-slate-100 dark:border-slate-800 mt-4 space-y-2 animate-in slide-in-from-top-4 duration-300">
                <div class="flex flex-col gap-1 text-xs font-black uppercase tracking-widest">
                    @if (isAdmin)
                    {
                        <a href="/Admin/Dashboard" class="px-4 py-3 rounded-xl transition-all @(currentAction == "Dashboard" ? "bg-brand-purple text-white shadow-md shadow-brand-purple/20" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900")">Dashboard</a>
                        <a href="/Admin/ManageEvents" class="px-4 py-3 rounded-xl transition-all @(currentAction == "ManageEvents" ? "bg-brand-purple text-white shadow-md shadow-brand-purple/20" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900")">Manage Events</a>
                        <a href="/Admin/ViewRegistrations" class="px-4 py-3 rounded-xl transition-all @(currentAction == "ViewRegistrations" ? "bg-brand-purple text-white shadow-md shadow-brand-purple/20" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900")">View Registrations</a>
                        <a href="/Admin/Logout" class="px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all">Secure Logout</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index" class="px-4 py-3 rounded-xl transition-all @(currentController == "Home" && currentAction == "Index" ? "bg-brand-purple text-white shadow-md shadow-brand-purple/20" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900")">Home</a>
                        <a asp-controller="Events" asp-action="Index" class="px-4 py-3 rounded-xl transition-all @(currentController == "Events" ? "bg-brand-purple text-white shadow-md shadow-brand-purple/20" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900")">Events</a>
                        <a asp-controller="Home" asp-action="Contact" class="px-4 py-3 rounded-xl transition-all @(currentController == "Home" && currentAction == "Contact" ? "bg-brand-purple text-white shadow-md shadow-brand-purple/20" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-900")">Contact</a>
                    }
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between px-2">
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Appearance Mode</span>
                    <button id="theme-toggle-mobile" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-500 border border-slate-200 dark:border-slate-800 hover:border-brand-purple transition-all">
                        <span class="dark:hidden text-base">🌙 Dark</span>
                        <span class="hidden dark:inline text-base text-brand-purple">☀️ Light</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mx-auto px-6 py-10 flex-grow animate-in fade-in duration-700">
        @if (TempData["Error"] != null)
        {
            <div class="mb-8 p-5 bg-rose-500/10 border-2 border-rose-500/30 text-rose-600 dark:text-rose-400 rounded-2xl flex items-center justify-between shadow-lg shadow-rose-500/5 animate-in fade-in zoom-in duration-300">
                <div class="flex items-center gap-3">
                    <span class="text-xl">⚠️</span>
                    <span class="text-xs font-black uppercase tracking-wider">@TempData["Error"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-1" aria-label="Dismiss">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null && currentAction != "Contact")
        {
            <div class="mb-8 p-5 bg-emerald-500/10 border-2 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-between shadow-lg shadow-emerald-500/5 animate-in fade-in zoom-in duration-300">
                <div class="flex items-center gap-3">
                    <span class="text-xl">✓</span>
                    <span class="text-xs font-black uppercase tracking-wider">@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-1" aria-label="Dismiss">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="mt-20 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 transition-colors duration-500">
        <div class="container mx-auto px-6 py-16">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-start mb-16">
                
                <div class="md:col-span-6 flex flex-col items-center md:items-start text-center md:text-left">
                    <div class="flex items-center gap-3 mb-6">
                        <img src="~/favicon.ico" class="w-10 h-10 rounded-xl" alt="EH" />
                        <span class="font-black text-2xl text-slate-900 dark:text-white tracking-tighter uppercase">
                            Event<span class="text-brand-purple">Hub</span>
                        </span>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 leading-relaxed max-w-sm font-medium italic text-lg">
                        "Curating Unforgettable Moments"
                    </p>
                    <p class="mt-4 text-xs font-bold text-slate-400 uppercase tracking-widest">
                        The next-generation campus engagement platform.
                    </p>
                </div>

                <div class="md:col-span-3 flex flex-col items-center md:items-start">
                    <h4 class="text-[10px] font-black uppercase tracking-widest text-brand-purple mb-6">Navigation</h4>
                    <div class="flex flex-col gap-4 text-xs font-bold text-slate-600 dark:text-slate-400">
                        @if (isAdmin) {
                            <a href="/Admin/Dashboard" class="hover:text-brand-purple transition-all">Dashboard</a>
                            <a href="/Admin/ManageEvents" class="hover:text-brand-purple transition-all">Manage Events</a>
                            <a href="/Admin/ViewRegistrations" class="hover:text-brand-purple transition-all">View Registrations</a>
                        } else {
                            <a asp-controller="Home" asp-action="Index" class="hover:text-brand-purple transition-all">Home</a>
                            <a asp-controller="Events" asp-action="Index" class="hover:text-brand-purple transition-all">Event Catalog</a>
                            <a asp-controller="Home" asp-action="Contact" class="hover:text-brand-purple transition-all">Contact Us</a>
                        }
                    </div>
                </div>

                <div class="md:col-span-3 flex flex-col items-center md:items-end">
                    <h4 class="text-[10px] font-black uppercase tracking-widest text-brand-purple mb-6">System Access</h4>
                    @if (isAdmin) {
                        <a href="/Admin/Logout" class="px-6 py-3 bg-red-500 text-white font-black text-[10px] uppercase tracking-widest rounded-xl hover:bg-red-600 transition-all shadow-lg shadow-red-500/10">
                            Secure Logout
                        </a>
                    } else {
                        <a href="/Admin/Login" class="group flex items-center gap-2 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-slate-900 dark:text-white border-2 border-slate-900 dark:border-white rounded-xl hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-slate-900 transition-all">
                            Admin Portal
                        </a>
                    }
                </div>
            </div>

            <div class="flex flex-col items-center justify-center pt-10 border-t border-slate-100 dark:border-slate-900">
                <div class="flex items-baseline justify-center gap-1.5 mb-2">
                    <span class="text-[11px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-500">
                        Made with <span class="inline-block text-xs">❤️</span> by
                    </span>                                        
                    <a
                        href="https://abhishekshah-portfolio.vercel.app/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative inline-flex items-baseline rounded-xl px-1.5 py-1
                            transition-all duration-300 ease-out
                            hover:bg-purple-500/[0.08]
                            focus-visible:outline-none focus-visible:ring-2
                            focus-visible:ring-purple-500/60"
                    >
                        <!-- Subtle glow behind the brand -->
                        <span
                            class="absolute inset-0 rounded-xl bg-gradient-to-r
                                from-violet-500/[0.08] via-fuchsia-500/[0.06] to-transparent
                                opacity-0 blur-md transition-opacity duration-300
                                group-hover:opacity-100"
                        ></span>

                        <!-- Brand name -->
                        <span
                            class="relative text-sm font-black uppercase tracking-[0.16em]
                                text-slate-900 dark:text-white
                                transition-colors duration-300
                                group-hover:text-violet-600
                                dark:group-hover:text-violet-400"
                        >
                            Abhishek Shah
                        </span> 
                    </a>
                </div>
                <p class="text-[9px] font-bold text-slate-400 dark:text-slate-600 uppercase tracking-widest">
                    &copy; 2026 Event Management System. All rights reserved.
                </p>
            </div>
        </div>
    </footer>

    <script>
        const html = document.documentElement;
        const themeBtn = document.getElementById('theme-toggle');
        const themeBtnMobile = document.getElementById('theme-toggle-mobile');
        const mobileMenuBtn = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');

        function toggleTheme() {
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.theme = 'light';
            } else {
                html.classList.add('dark');
                localStorage.theme = 'dark';
            }
        }

        if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
        if (themeBtnMobile) themeBtnMobile.addEventListener('click', toggleTheme);

        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }

        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        } else {
            html.classList.remove('dark');
        }
    </script>
</body>
</html>