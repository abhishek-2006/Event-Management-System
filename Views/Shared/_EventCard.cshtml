@model EventManagementSystem.Models.Event

@{
    var today = DateTime.Today;
    bool isPast = Model.EventDate.Date < today;
    bool isLive = Model.EventDate.Date == today;
    bool isUpcoming = Model.EventDate.Date > today;

    bool notYetOpen = today < Model.RegistrationStartDate.Date;
    bool isClosed = today > Model.RegistrationEndDate.Date || isPast;
    bool isOpen = !notYetOpen && !isClosed;

    var categoryColor = Model.Category switch {
        "Technical" => "text-emerald-600 bg-emerald-50 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-100 dark:border-emerald-800",
        "Cultural" => "text-brand-purple bg-purple-50 dark:bg-purple-900/30 dark:text-purple-400 border-purple-100 dark:border-purple-800",
        "Sports" => "text-amber-600 bg-amber-50 dark:bg-amber-900/30 dark:text-amber-400 border-amber-100 dark:border-amber-800",
        "Education" => "text-brand-blue bg-blue-50 dark:bg-blue-900/30 dark:text-blue-400 border-blue-100 dark:border-blue-800",
        _ => "text-slate-600 bg-slate-50 dark:bg-slate-800 dark:text-slate-400 border-slate-100 dark:border-slate-800"
    };
}

<div class="event-card group bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-brand-purple/40 rounded-[2rem] p-2.5 transition-all duration-500 hover:shadow-[0_0_40px_-10px_rgba(139,92,246,0.2)] hover:-translate-y-1.5 flex flex-col" 
     data-category="@Model.Category" data-title="@Model.Title.ToLower()">
    <div class="relative bg-slate-50 dark:bg-slate-950 rounded-[1.75rem] p-7 h-full flex flex-col justify-between overflow-hidden">
        
        <div>
            <!-- Header Pill & Date -->
            <div class="flex justify-between items-center mb-6">
                <span class="px-4 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest border @categoryColor">
                    @Model.Category
                </span>
                <div class="text-right">
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                        @(isPast ? "Ended" : isLive ? "Today" : "Date")
                    </p>
                    <p class="text-xs font-bold text-slate-700 dark:text-slate-300">@Model.EventDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-3 leading-snug group-hover:text-brand-purple transition-colors line-clamp-1">
                @Model.Title
            </h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-6 line-clamp-2">
                @Model.Description
            </p>

            <!-- Status Badge & Location -->
            <div class="flex flex-wrap items-center gap-3 mb-6">
                @if (isPast)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-200/60 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-black uppercase tracking-widest">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Concluded
                    </span>
                }
                else if (isLive)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-[10px] font-black uppercase tracking-widest">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Live Today
                    </span>
                }
                else if (isOpen)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-purple/10 border border-brand-purple/20 text-brand-purple text-[10px] font-black uppercase tracking-widest">
                        <span class="w-1.5 h-1.5 rounded-full bg-brand-purple"></span> Reg. Open
                    </span>
                }
                else if (notYetOpen)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-500 text-[10px] font-black uppercase tracking-widest">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Opens Soon
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-500 text-[10px] font-black uppercase tracking-widest">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Reg. Closed
                    </span>
                }

                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                    <span>📍</span> @Model.Location
                </span>
            </div>
        </div>

        <!-- Footer / Action Area with Proper Pill Button -->
        <div class="pt-5 flex items-center justify-between border-t border-slate-200/60 dark:border-slate-800">
            <div>
                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Entry Fee</p>
                <p class="text-sm font-black text-slate-900 dark:text-white">@(Model.Price == 0 ? "Free" : $"₹{Model.Price}")</p>
            </div>

            <a asp-controller="Events" asp-action="Details" asp-route-slug="@Model.Slug" 
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-brand-gradient hover:text-white dark:hover:bg-brand-gradient dark:hover:text-white text-[11px] font-black uppercase tracking-wider transition-all duration-300 shadow-sm hover:shadow-md hover:scale-105 active:scale-95">
                <span>Details</span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                </svg>
            </a>
        </div>
    </div>
</div>