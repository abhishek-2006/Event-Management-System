@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-6">
    <div class="relative w-full max-w-xl">
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-64 h-64 bg-brand-purple/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative bg-white dark:bg-slate-900 rounded-[3rem] p-10 md:p-14 border border-slate-100 dark:border-slate-800 shadow-2xl text-center">
            
            <div class="w-20 h-20 bg-rose-500/10 text-rose-500 rounded-3xl flex items-center justify-center text-4xl mx-auto mb-8 shadow-inner">
                ⚡
            </div>

            <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight uppercase italic mb-4">
                Oops, Something Went <span class="text-rose-500">Off-Track</span>
            </h1>

            <p class="text-slate-500 dark:text-slate-400 font-medium text-base md:text-lg mb-8 leading-relaxed max-w-md mx-auto">
                An unexpected condition interrupted your request. Our system has logged the event and our team is monitoring it.
            </p>

            @if (Model != null && Model.ShowRequestId)
            {
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-slate-50 dark:bg-slate-800/80 rounded-full border border-slate-200 dark:border-slate-700/60 text-[11px] font-mono text-slate-500 dark:text-slate-400 mb-8">
                    <span class="font-bold uppercase tracking-wider text-[9px] text-brand-purple">Trace ID</span>
                    <code>@Model.RequestId</code>
                </div>
            }

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                <a href="/" class="w-full sm:w-auto px-8 py-4 bg-brand-gradient hover:opacity-95 text-white font-black text-xs uppercase tracking-widest rounded-2xl shadow-xl shadow-brand-purple/20 transition-all hover:scale-105 active:scale-95">
                    Return to Homepage
                </a>
                <a href="/Events" class="w-full sm:w-auto px-8 py-4 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-black text-xs uppercase tracking-widest rounded-2xl transition-all">
                    Browse Events
                </a>
            </div>
        </div>
    </div>
</div>
