@model IEnumerable<EventManagementSystem.Models.Event>
@{
    ViewData["Title"] = "Home Page";
}

<div class="space-y-24 pb-20">
    <section class="relative min-h-[70vh] flex flex-col items-center justify-center text-center px-4 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10">
            <div class="absolute top-10 left-10 w-72 h-72 bg-blue-400/20 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-10 right-10 w-96 h-96 bg-purple-400/20 rounded-full blur-3xl animate-pulse delay-700"></div>
        </div>

        <div class="animate-in fade-in slide-in-from-bottom-8 duration-1000">
            
            <h1 class="text-5xl md:text-8xl font-black text-slate-900 dark:text-white tracking-tighter mb-6 leading-tight">
                Every Moment <br />
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-500">Becomes an Event.</span>
            </h1>   
            
            <p class="mt-4 text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto font-medium leading-relaxed">
                The official hub for campus workshops, cultural fests, and seminars. 
                Experience your college journey like never before.
            </p>

            <div class="flex flex-wrap justify-center gap-4 mt-10">
                <a asp-controller="Events" asp-action="Index" 
                   class="px-10 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl transition-all shadow-2xl shadow-blue-500/40 hover:-translate-y-1">
                    Explore Events
                </a>
                <a asp-controller="Home" asp-action="Contact" 
                   class="px-10 py-4 bg-white dark:bg-slate-800 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 font-bold rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-700 transition-all hover:-translate-y-1">
                    Get in Touch
                </a>
            </div>
        </div>
    </section>

    <section class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
                <h2 class="text-4xl font-black text-slate-900 dark:text-white tracking-tight">
                    Upcoming <span class="text-blue-600">Highlights</span>
                </h2>
                <p class="text-slate-500 dark:text-slate-400 mt-2 font-medium">Don't miss out on these handpicked campus experiences.</p>
            </div>
            <a asp-controller="Events" asp-action="Index" class="group text-sm font-bold text-blue-600 dark:text-blue-400 flex items-center gap-2">
                Browse all events 
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @if(Model != null && Model.Any())
            {
                @foreach (var item in Model.Take(3))    
                {
                    <div class="group relative bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-[2.5rem] p-8 shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-500 hover:-translate-y-2 flex flex-col min-h-[400px]">
                        <div class="absolute top-8 right-8 text-[10px] font-black uppercase tracking-[0.2em] text-slate-300 dark:text-slate-600 vertical-text">
                            @item.Category
                        </div>

                        <div class="mb-6">
                            <span class="px-4 py-1.5 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 text-[10px] font-black rounded-full uppercase tracking-widest">
                                @item.Category
                            </span>
                        </div>

                        <h3 class="text-2xl font-black text-slate-900 dark:text-white mb-4 leading-tight group-hover:text-blue-600 transition-colors">
                            @item.Title
                        </h3>

                        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-8 line-clamp-3">
                            @item.Description
                        </p>

                        <div class="mt-auto pt-6 border-t border-slate-50 dark:border-slate-700/50 flex items-center justify-between">
                            <div class="flex flex-col">
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Event Date</span>
                                <span class="text-sm font-bold text-slate-700 dark:text-slate-300">@item.EventDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <a asp-controller="Events" asp-action="Register" asp-route-slug="@item.Slug" 
                               class="w-12 h-12 bg-slate-900 dark:bg-slate-700 text-white rounded-2xl flex items-center justify-center hover:bg-blue-600 transition-colors shadow-lg shadow-slate-900/20 dark:shadow-none">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full py-20 text-center bg-slate-50 dark:bg-slate-900/50 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-[3rem]">
                    <span class="text-4xl mb-4 block">🏮</span>
                    <p class="text-slate-500 font-bold">No upcoming events scheduled yet.</p>
                </div>
            }
        </div>
    </section>
</div>