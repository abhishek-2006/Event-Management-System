@{
    ViewData["Title"] = "Contact Us";
}

<div class="py-16 max-w-7xl mx-auto px-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-10 p-6 bg-emerald-50 dark:bg-emerald-900/30 border-2 border-emerald-500 text-emerald-600 dark:text-emerald-400 rounded-3xl animate-in fade-in zoom-in duration-500">
            <div class="flex items-center gap-3">
                <span class="text-2xl">✅</span>
                <p class="font-black uppercase tracking-widest text-sm">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    <div class="relative mb-20 text-center md:text-left">
        <div class="animate-in fade-in slide-in-from-bottom-8 duration-1000">
            <h1 class="text-6xl md:text-8xl font-black text-slate-900 dark:text-white tracking-tighter leading-none mb-6">
                Connect with <br />
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-500 italic">The Hub.</span>
            </h1>
            <p class="max-w-2xl text-xl text-slate-500 dark:text-slate-400 font-medium leading-relaxed">
                Facing technical hurdles or have questions about an upcoming event? Our team at Navnirman College is ready to assist you.
            </p>
        </div>
        <div class="absolute -top-20 -right-20 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px] -z-10 animate-pulse"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5 space-y-6 order-2 lg:order-1">
            <div class="p-10 bg-blue-600 rounded-[3rem] text-white shadow-2xl shadow-blue-500/30 group transition-all duration-500 hover:-translate-y-2 border-4 border-blue-400/20">
                <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center text-4xl mb-8 group-hover:scale-110 transition-transform">⚡</div>
                <h3 class="text-3xl font-black mb-3 tracking-tight">Technical Support</h3>
                <p class="text-blue-100 font-medium mb-8 text-lg">Facing bugs or registration issues? Our developers are ready.</p>
                <a href="mailto:support@eventhub.com" class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest bg-white text-blue-600 py-4 px-8 rounded-2xl hover:bg-blue-50 transition-all">
                    Email Support
                </a>
            </div>

            <div class="p-10 bg-white dark:bg-slate-800 rounded-[3rem] border-4 border-slate-100 dark:border-slate-700 group transition-all duration-500 hover:-translate-y-2 hover:border-blue-600">
                <div class="w-16 h-16 bg-slate-50 dark:bg-slate-900 rounded-2xl flex items-center justify-center text-4xl mb-8 group-hover:rotate-12 transition-transform">📍</div>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white mb-3 tracking-tight">Admin Office</h3>
                <p class="text-slate-500 dark:text-slate-400 font-medium mb-8 text-lg">Block A, Room 402, <br />Navnirman College Campus.</p>
                <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-blue-600">
                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span>
                    Open: Mon — Fri (9AM - 4PM)
                </div>
            </div>
        </div>

        <div class="lg:col-span-7 order-1 lg:order-2">
            <div class="bg-white dark:bg-slate-900 rounded-[3rem] p-12 border-2 border-slate-200 dark:border-white">
                <h3 class="text-4xl font-black text-slate-900 dark:text-white mb-10 tracking-tight">Drop a Message</h3>
                
                <form asp-controller="Home" asp-action="Contact" method="POST" class="space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Full Name</label>
                            <input type="text" name="fullName" required placeholder="Abhishek Shah" class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border-2 border-transparent rounded-2xl text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-blue-600 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">College Email</label>
                            <input type="email" name="email" required placeholder="student@college.edu" class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border-2 border-transparent rounded-2xl text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-blue-600 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Subject</label>
                        <input type="text" name="subject" required placeholder="Registration Issue" class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border-2 border-transparent rounded-2xl text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-blue-600 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Your Message</label>
                        <textarea rows="4" name="message" required placeholder="How can we help you?" class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border-2 border-transparent rounded-2xl text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-blue-600 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all resize-none"></textarea>
                    </div>

                    <button type="submit" class="group/btn relative w-full py-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-sm uppercase tracking-widest rounded-2xl overflow-hidden transition-all hover:scale-[1.02] active:scale-95 shadow-2xl">
                        <span class="relative z-10">Send to Support</span>
                        <div class="absolute inset-0 bg-blue-600 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-300"></div>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>