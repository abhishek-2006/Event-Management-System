@{
    ViewData["Title"] = "Contact Us";
}

<div class="py-16 max-w-7xl mx-auto px-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-10 p-6 bg-emerald-500/10 border-2 border-emerald-500/50 text-emerald-600 dark:text-emerald-400 rounded-[2rem] animate-in fade-in zoom-in duration-500 shadow-xl shadow-emerald-500/10">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-emerald-500 rounded-full flex items-center justify-center text-white text-xl">✓</div>
                <p class="font-black uppercase tracking-widest text-xs">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    <div class="relative mb-24 text-center lg:text-left">
        <div class="animate-in fade-in slide-in-from-bottom-8 duration-1000">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-purple/10 border border-brand-purple/20 mb-8">
                <span class="text-[10px] font-black text-brand-purple uppercase tracking-[0.3em]">Support Center</span>
            </div>
            <h1 class="text-6xl md:text-8xl font-black text-slate-900 dark:text-white tracking-tighter leading-[0.9] mb-8">
                Connect with <br />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-purple to-brand-blue italic">The Hub.</span>
            </h1>
            <p class="max-w-2xl text-xl text-slate-500 dark:text-slate-400 font-medium leading-relaxed">
                Facing technical hurdles or have questions about an upcoming event? Our team at AMTICS, UTU is ready to assist you.
            </p>
        </div>
        <div class="absolute -top-24 -right-24 w-[30rem] h-[30rem] bg-brand-blue/5 rounded-full blur-[120px] -z-10 animate-pulse"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
        <div class="lg:col-span-5 space-y-8 order-2 lg:order-1">
            <div class="p-10 bg-gradient-to-br from-brand-purple to-brand-blue rounded-[3rem] text-white shadow-2xl shadow-brand-purple/20 group transition-all duration-500 hover:-translate-y-2 border-4 border-white/10">
                <div class="w-16 h-16 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center text-4xl mb-8 group-hover:scale-110 transition-transform">⚡</div>
                <h3 class="text-3xl font-black mb-3 tracking-tight uppercase italic">Technical Support</h3>
                <p class="text-blue-50 font-medium mb-10 text-lg opacity-90">Facing bugs or registration issues? Our developers are ready.</p>
                <a href="mailto:support@eventhub.com" class="inline-flex items-center justify-center w-full py-5 bg-white text-brand-purple font-black text-xs uppercase tracking-widest rounded-2xl hover:bg-slate-50 transition-all shadow-xl">
                    Email Support
                </a>
            </div>

            <div class="p-10 bg-white dark:bg-slate-900 rounded-[3rem] border-4 border-slate-100 dark:border-slate-800 group transition-all duration-500 hover:-translate-y-2 hover:border-brand-purple shadow-sm">
                <div class="w-16 h-16 bg-slate-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center text-4xl mb-8 group-hover:rotate-12 transition-transform">📍</div>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white mb-3 tracking-tight uppercase italic">Admin Office</h3>
                <p class="text-slate-500 dark:text-slate-400 font-medium mb-10 text-lg leading-relaxed">Block A, Room 402, <br />AMTICS, UTU Campus.</p>
                <div class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-brand-blue">
                    <span class="w-2 h-2 rounded-full bg-brand-blue animate-ping"></span>
                    Open: Mon — Fri (9AM - 4PM)
                </div>
            </div>
        </div>

        <div class="lg:col-span-7 order-1 lg:order-2">
            <div class="bg-white dark:bg-slate-900 rounded-[3.5rem] p-12 border-2 border-slate-100 dark:border-slate-800 shadow-2xl">
                <div class="flex items-center gap-4 mb-12">
                    <div class="w-12 h-12 rounded-2xl overflow-hidden border-2 border-slate-100 dark:border-slate-800">
                        <img src="~/favicon.ico" class="w-full h-full object-cover" />
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 dark:text-white tracking-tighter uppercase italic">Drop a Message</h3>
                </div>
                
                <form asp-controller="Home" asp-action="Contact" method="POST" class="space-y-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Full Identity</label>
                            <input type="text" name="fullName" required placeholder="Abhishek Shah" 
                                   class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">College Email</label>
                            <input type="email" name="email" required placeholder="student@college.edu" 
                                   class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">Message Subject</label>
                        <input type="text" name="subject" required placeholder="Registration Issue" 
                               class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    </div>

                    <div class="space-y-3">
                        <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 ml-1">How can we help?</label>
                        <textarea rows="5" name="message" required placeholder="Describe your inquiry..." 
                                  class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all resize-none shadow-inner"></textarea>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="group relative w-full py-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-sm uppercase tracking-[0.3em] rounded-[2rem] overflow-hidden transition-all hover:scale-[1.02] active:scale-95 shadow-2xl">
                            <span class="relative z-10">Launch Message</span>
                            <div class="absolute inset-0 bg-gradient-to-r from-brand-purple to-brand-blue translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>