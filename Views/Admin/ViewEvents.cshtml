@model IEnumerable<EventManagementSystem.Models.Event>

<div class="relative bg-gradient-to-tr from-blue-50 to-purple-50 dark:from-slate-800 dark:to-slate-900 rounded-3xl p-8 mb-12 overflow-hidden">
        <div class="relative z-10">
            <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tight mb-4">Current Events</h1>
            <p class="text-lg text-slate-500 dark:text-slate-400 max-w-2xl">Explore the list of active events currently available. You can view details, manage registrations, and ensure everything is running smoothly for each event.</p>
            <div class="mt-6">
                <a href="/Admin/CreateEvent" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">Add New Event</a>
            </div>
            <div class="mt-8">
                <table class="min-w-full bg-white dark:bg-slate-800 rounded-lg shadow-md overflow-hidden">
                    <thead>
                        <tr class="bg-gray-100 dark:bg-slate-700 text-left">
                            <th class="px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Title</th>
                            <th class="px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Location</th>
                            <th class="px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Slug</th>
                            <th class="px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr class="border-t border-gray-200 dark:border-slate-700">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900 dark:text-white">@ev.Title</div>
                                    <div class="text-sm text-gray-500 dark:text-slate-400">@ev.Description</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full bg-blue-100 text-blue-800">@ev.Category</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 dark:text-white">@ev.EventDate.ToString("MMMM dd, yyyy")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 dark:text-white">@ev.Location</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 dark:text-white">@ev.Slug</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/Admin/EditEvent/@ev.Slug" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300">Edit</a>
                                    <a href="/Admin/DeleteEvent/@ev.Slug" class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300 ml-4">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>