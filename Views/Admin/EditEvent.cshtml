@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Edit — " + @Model.Slug;
}

<div class="py-10 max-w-7xl mx-auto px-6">
    <div class="mb-12">
        <a href="/Admin/ManageEvents" class="group inline-flex items-center gap-3 px-4 py-2 rounded-full border border-transparent hover:border-brand-purple/20 hover:bg-brand-purple/5 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-brand-purple transition-all mb-6">
            <span class="group-hover:-translate-x-1 transition-transform">&larr;</span> Back to Manage Events
        </a>
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tighter uppercase leading-none">
            Edit <span class="text-transparent bg-clip-text bg-brand-gradient">Event</span>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 font-medium text-lg mt-4">
            Modifying: <span class="text-slate-900 dark:text-white font-black uppercase tracking-widest text-sm underline decoration-brand-purple decoration-2 underline-offset-4">@Model.Title</span>
        </p>
    </div>

    <form asp-action="EditEvent" asp-controller="Admin" asp-route-slug="@Model.Slug" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="Slug" />

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="All" class="col-span-full p-6 bg-rose-500/10 border-2 border-rose-500/30 text-rose-500 rounded-[2rem] text-sm font-bold shadow-lg"></div>
        }

        <div class="lg:col-span-7 space-y-8 bg-white dark:bg-slate-900 p-8 md:p-12 rounded-[3rem] border border-slate-200 dark:border-slate-800 shadow-xl">
            
            <div class="space-y-2">
                <label asp-for="Title" class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1">Event Title</label>
                <input asp-for="Title" placeholder="Update title..." 
                       class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-brand-purple focus:ring-4 focus:ring-brand-purple/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all" />
                <span asp-validation-for="Title" class="text-xs text-rose-500 font-bold ml-1"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Description" class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1">Description Update</label>
                <textarea asp-for="Description" rows="6" placeholder="Update the event highlights..." 
                    class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-brand-purple focus:ring-4 focus:ring-brand-purple/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all resize-none"></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-500 font-bold ml-1"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Category" class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-1">Re-Classify Event</label>
                <div class="relative group">
                    <select asp-for="Category" class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-bold text-slate-900 dark:text-white focus:border-brand-purple focus:ring-4 focus:ring-brand-purple/10 focus:bg-white dark:focus:bg-slate-900 outline-none appearance-none cursor-pointer transition-all">
                        <option value="Technical">Technical</option>
                        <option value="Sports">Sports</option>
                        <option value="Cultural">Cultural</option>
                        <option value="Education">Education</option>
                    </select>
                    <div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 group-focus-within:text-brand-purple transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>
                <span asp-validation-for="Category" class="text-xs text-rose-500 font-bold ml-1"></span>
            </div>
        </div>

        <div class="lg:col-span-5 space-y-8 lg:sticky lg:top-32">
            
            <div class="bg-white dark:bg-slate-900 rounded-[3rem] p-8 md:p-10 border border-slate-200 dark:border-slate-800 shadow-xl relative overflow-hidden">
                <div class="absolute -top-12 -right-12 w-32 h-32 bg-brand-purple/15 rounded-full blur-3xl pointer-events-none"></div>

                <div class="space-y-6 relative z-10">
                    <div class="space-y-2">
                        <label asp-for="EventDate" class="text-[10px] font-black uppercase tracking-widest text-brand-purple ml-1">Update Event Date</label>
                        <input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" 
                            class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-bold text-slate-900 dark:text-white focus:border-brand-purple focus:ring-4 focus:ring-brand-purple/10 outline-none transition-all" />
                        <span asp-validation-for="EventDate" class="text-xs text-rose-500 ml-1"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="RegistrationStartDate" class="text-[10px] font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400 ml-1">Registration Opens</label>
                        <input asp-for="RegistrationStartDate" type="date" asp-format="{0:yyyy-MM-dd}"
                            class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-bold text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 outline-none transition-all" />
                        <span asp-validation-for="RegistrationStartDate" class="text-xs text-rose-500 ml-1"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="RegistrationEndDate" class="text-[10px] font-black uppercase tracking-widest text-rose-500 ml-1">Registration Closes</label>
                        <input asp-for="RegistrationEndDate" type="date" asp-format="{0:yyyy-MM-dd}"
                            class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-bold text-slate-900 dark:text-white focus:border-rose-500 focus:ring-4 focus:ring-rose-500/10 outline-none transition-all" />
                        <span asp-validation-for="RegistrationEndDate" class="text-xs text-rose-500 ml-1"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="Location" class="text-[10px] font-black uppercase tracking-widest text-brand-purple ml-1">Update Venue</label>
                        <input asp-for="Location" placeholder="Enter new location..." 
                            class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-bold text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-brand-purple focus:ring-4 focus:ring-brand-purple/10 outline-none transition-all" />
                        <span asp-validation-for="Location" class="text-xs text-rose-500 ml-1"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="Price" class="text-[10px] font-black uppercase tracking-widest text-brand-purple ml-1">Adjust Fee (INR)</label>
                        <input asp-for="Price" type="number" step="0.01" 
                            class="w-full px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl text-base font-bold text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-brand-purple focus:ring-4 focus:ring-brand-purple/10 outline-none transition-all" />
                        <span asp-validation-for="Price" class="text-xs text-rose-500 ml-1"></span>
                    </div>

                    <div class="pt-4">
                        <button type="submit" 
                            class="group relative w-full py-5 bg-brand-gradient text-white font-black text-xs uppercase tracking-widest rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[1.02] active:scale-95 shadow-xl shadow-brand-purple/20">
                            <span class="relative z-10 flex items-center justify-center gap-2">
                                Save Changes
                                <svg class="w-4 h-4 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                            </span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="p-6 bg-amber-500/5 border border-dashed border-amber-500/20 rounded-3xl">
                <p class="text-[10px] font-black text-amber-600 dark:text-amber-500 uppercase tracking-widest mb-1.5 flex items-center gap-2">
                    <span>⚠️</span> System Notice:
                </p>
                <p class="text-xs font-medium text-slate-500 dark:text-slate-400 leading-relaxed">
                    Modifying live records updates the public catalog and delegate pass references immediately.
                </p>
            </div>
        </div>
    </form>
</div>