@model EventManagementSystem.Models.Admin

@{
    ViewData["Title"] = "Admin Login";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventHub</title>
    <link rel="icon" type="image/jpeg" href="~/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { 
                        'brand-purple': '#8b5cf6',
                        'brand-blue': '#3b82f6'
                    },
                    backgroundImage: {
                        'brand-gradient': 'linear-gradient(to right, #8b5cf6, #3b82f6)',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 transition-colors duration-300 selection:bg-brand-purple/30">

    <div class="min-h-screen flex items-center justify-center py-12 px-6 overflow-hidden relative">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40rem] h-[40rem] bg-brand-purple/5 rounded-full blur-[120px] -z-10 animate-pulse"></div>
        
        <div class="relative w-full max-w-lg">
            <div class="relative bg-white dark:bg-slate-900 rounded-[3.5rem] p-12 border-2 border-slate-100 dark:border-slate-800 shadow-[0_50px_100px_-20px_rgba(0,0,0,0.2)] animate-in fade-in zoom-in duration-700">
                
                <div class="text-center mb-12">
                    <div class="inline-flex p-1 bg-brand-gradient rounded-3xl shadow-2xl shadow-brand-purple/20 mb-8 rotate-3 hover:rotate-0 transition-transform duration-500">
                        <img src="~/logo.png" class="w-20 h-20 rounded-[1.2rem] object-cover" alt="EH" />
                    </div>
                    <h2 class="text-4xl font-black text-slate-900 dark:text-white tracking-tighter uppercase italic">
                        Admin <span class="text-transparent bg-clip-text bg-brand-gradient">Portal</span>
                    </h2>
                    <p class="text-slate-400 font-bold mt-2 uppercase tracking-[0.2em] text-[10px]">Restricted Access Area</p>
                </div>

                <form asp-action="Login" method="post" class="space-y-8">
                    @Html.AntiForgeryToken()
                    
                    <div class="space-y-3">
                        <label class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 ml-2">Secure Identifier</label>
                        <input name="login" required placeholder="Username" 
                               class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    </div>

                    <div class="space-y-3">
                        <label class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-400 ml-2">Access Key</label>
                        <input name="password" type="password" required placeholder="••••••••" 
                               class="w-full px-8 py-5 bg-slate-50 dark:bg-slate-800/50 border-2 border-transparent rounded-[2rem] text-lg font-bold text-slate-900 dark:text-white placeholder:text-slate-300 focus:border-brand-purple focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-inner" />
                    </div>

                    <div class="pt-6">
                        <button type="submit" 
                                class="group relative w-full py-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-xs uppercase tracking-[0.4em] rounded-[2rem] overflow-hidden transition-all duration-300 hover:scale-[1.02] active:scale-95 shadow-2xl shadow-brand-purple/20">
                            <span class="relative z-10">Login</span>
                            <div class="absolute inset-0 bg-gradient-to-r from-brand-purple to-brand-blue translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"></div>
                        </button>
                    </div>
                </form>

                <div class="mt-12 text-center border-t border-slate-50 dark:border-slate-800 pt-8">
                    <a href="/" class="group inline-flex items-center gap-2 text-[10px] font-black text-slate-400 hover:text-brand-purple uppercase tracking-widest transition-all">
                        <span class="group-hover:-translate-x-1 transition-transform">&larr;</span> Return to EventHub
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        if (window.history.replaceState) {
            window.history.replaceState(null, null, window.location.href);
        }
    </script>
</body>
</html>