@{
    ViewData["Title"] = "Admin Dashboard";
    var totalEvents = ViewBag.TotalEvents ?? 0;
    var totalRegistrations = ViewBag.TotalRegistrations ?? 0;
}

<div class="max-w-7xl mx-auto py-10 px-6 space-y-10">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-slate-900 p-8 md:p-14 shadow-2xl border border-slate-800">
        <div class="relative z-10 animate-in fade-in slide-in-from-left-6 duration-1000">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 mb-6">
                <span class="flex h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
                <span class="text-[9px] font-black text-blue-400 uppercase tracking-[0.3em]">System Live</span>
            </div>
            <h2 class="text-4xl md:text-6xl font-black text-white tracking-tighter leading-none">
                Welcome, @Context.Session.GetString("Admin")! 👋
            </h2>
            <p class="text-slate-400 mt-4 text-base md:text-lg font-medium max-w-xl leading-relaxed">
                Manage your campus ecosystem and track real-time engagement from your central hub.
            </p>
        </div>
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-blue-600/10 blur-[80px]"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white dark:bg-slate-800 p-10 rounded-[2.5rem] border border-slate-100 dark:border-slate-700 transition-all hover:border-blue-500 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <span class="text-4xl">📅</span>
                <span class="text-[10px] font-black text-emerald-500 bg-emerald-50 dark:bg-emerald-900/30 px-3 py-1 rounded-full uppercase tracking-widest">+@totalEvents New</span>
            </div>
            <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em]">Active Events</p>
            <h3 class="text-5xl font-black text-slate-900 dark:text-white mt-2 tracking-tighter">@totalEvents</h3>
        </div>

        <div class="bg-white dark:bg-slate-800 p-10 rounded-[2.5rem] border border-slate-100 dark:border-slate-700 transition-all hover:border-purple-500 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <span class="text-4xl">👥</span>
                <span class="text-[10px] font-black text-purple-500 bg-purple-50 dark:bg-purple-900/30 px-3 py-1 rounded-full uppercase tracking-widest">Realtime</span>
            </div>
            <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em]">Total Registrations</p>
            <h3 class="text-5xl font-black text-slate-900 dark:text-white mt-2 tracking-tighter">@totalRegistrations</h3>
        </div>
    </div>

    <div class="space-y-6 pt-6">
        <div class="flex items-center gap-3 px-1">
            <span class="h-6 w-1.5 bg-blue-600 rounded-full"></span>
            <h3 class="text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight uppercase italic">Operations</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <a href="/Admin/CreateEvent" class="group bg-white dark:bg-slate-800 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-700 hover:border-blue-600 transition-all shadow-lg hover:shadow-blue-500/5">
                <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">✨</div>
                <h4 class="text-xl font-black text-slate-900 dark:text-white">Create Event</h4>
                <p class="text-slate-500 text-sm mt-2 leading-relaxed">Launch a new seminar or workshop.</p>
                <p class="mt-8 text-blue-600 font-black text-[10px] uppercase tracking-[0.2em]">Open Builder &rarr;</p>
            </a>

            <a href="/Admin/ManageEvents" class="group bg-white dark:bg-slate-800 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-700 hover:border-purple-600 transition-all shadow-lg hover:shadow-purple-500/5">
                <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">⚙️</div>
                <h4 class="text-xl font-black text-slate-900 dark:text-white">Manage Events</h4>
                <p class="text-slate-500 text-sm mt-2 leading-relaxed">Edit details or delete active events.</p>
                <p class="mt-8 text-purple-600 font-black text-[10px] uppercase tracking-[0.2em]">View All &rarr;</p>
            </a>

            <a href="/Admin/Registrations" class="group bg-white dark:bg-slate-800 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-700 hover:border-amber-600 transition-all shadow-lg hover:shadow-amber-500/5">
                <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">📋</div>
                <h4 class="text-xl font-black text-slate-900 dark:text-white">Student Registrations</h4>
                <p class="text-slate-500 text-sm mt-2 leading-relaxed">Verify registrations and student records.</p>
                <p class="mt-8 text-amber-600 font-black text-[10px] uppercase tracking-[0.2em]">View Records &rarr;</p>
            </a>
        </div>
    </div>
</div>