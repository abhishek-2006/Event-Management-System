@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tight mb-4">Delete Event</h1>
<h3 class="text-lg text-slate-500 dark:text-slate-400 max-w-2xl mb-6">Are you sure you want to delete this event? This action cannot be undone.</h3>
<div class="bg-white dark:bg-slate-800 rounded-lg shadow-md p-6 mb-8">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">@Model.Title</h2>
    <p class="text-sm text-gray-500 dark:text-slate-400 mb-6">@Model.Description</p>
    <form method="post">
        <input type="hidden" asp-for="EventId" />
        <button type="submit" class="px-6 py-3 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors">Delete Event</button>
        <a href="/Admin/ViewEvents" class="ml-4 px-6 py-3 bg-gray-300 text-gray-800 rounded-md hover:bg-gray-400 transition-colors">Cancel</a>
    </form>
</div>