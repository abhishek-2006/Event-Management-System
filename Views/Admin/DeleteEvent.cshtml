@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Delete Event — " + (Model?.Title ?? "Event");
}

<div class="max-w-2xl mx-auto py-12 px-6">
    <div class="bg-white dark:bg-slate-900 rounded-[3rem] p-10 md:p-12 border border-slate-200 dark:border-slate-800 shadow-2xl relative overflow-hidden text-center">
        <div class="w-20 h-20 bg-rose-500/10 text-rose-500 rounded-3xl flex items-center justify-center text-4xl mx-auto mb-6 shadow-inner">
            ☣️
        </div>

        <h1 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight uppercase italic mb-3">
            Delete Event
        </h1>
        <p class="text-slate-500 dark:text-slate-400 font-medium text-sm max-w-md mx-auto mb-8">
            Are you sure you want to permanently delete <strong class="text-slate-900 dark:text-white font-black">@(Model?.Title ?? "this event")</strong>? This action cannot be reversed.
        </p>

        @if (Model != null)
        {
            <div class="p-6 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-800 mb-8 text-left space-y-2">
                <span class="px-3 py-1 bg-white dark:bg-slate-800 rounded-full text-[9px] font-black uppercase tracking-widest text-brand-purple border border-brand-purple/20">
                    @Model.Category
                </span>
                <h3 class="text-xl font-black text-slate-900 dark:text-white">@Model.Title</h3>
                <p class="text-slate-400 text-xs line-clamp-2">@Model.Description</p>
                <div class="pt-2 text-[10px] font-bold text-slate-400 flex items-center gap-3">
                    <span>📅 @Model.EventDate.ToString("MMM dd, yyyy")</span>
                    <span>📍 @Model.Location</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="/Admin/DeleteEvent/@Model.Slug" 
                   class="w-full sm:w-auto px-8 py-4 bg-rose-600 hover:bg-rose-700 text-white font-black text-xs uppercase tracking-widest rounded-2xl shadow-xl shadow-rose-600/20 transition-all hover:scale-105 active:scale-95">
                    Confirm & Purge Event
                </a>
                <a href="/Admin/ManageEvents" 
                   class="w-full sm:w-auto px-8 py-4 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-black text-xs uppercase tracking-widest rounded-2xl transition-all">
                    Cancel & Return
                </a>
            </div>
        }
        else
        {
            <a href="/Admin/ManageEvents" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-purple text-white font-black text-xs uppercase tracking-widest rounded-2xl">
                &larr; Back to Events
            </a>
        }
    </div>
</div>